// Cloudflare Workers (static assets) config — the dashboard's git-connected
// build runs `npx next build` (which exports to out/) then `npx wrangler deploy`.
{
  "name": "tanawin-payroll",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page"
  }
}
