# Copy to .env — Supabase project: tanawin-payroll (its OWN project, never Finance's)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Login users: comma-separated "Name:email" pairs. The login screen shows the
# names; each name's email + her own PIN are what Supabase Auth checks.
NEXT_PUBLIC_LOGIN_USERS=

# The service role key goes in .env.local (gitignored) — never commit or print it:
# SUPABASE_SERVICE_ROLE_KEY=
